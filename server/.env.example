# Copy to .env, fill in, then: chmod 600 .env github-app-key.pem

# --- GitHub App (see README.md "One-time setup") --------------------------
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY_PATH is set in docker-compose.yml directly, not here
LUTR_REPO=cyberhirsch/LUTr
LUTR_BASE_BRANCH=main

# --- Admin ------------------------------------------------------------------
# Bearer token required on every /admin/* endpoint. Generate with, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LUTR_ADMIN_TOKEN=

# --- Privacy -----------------------------------------------------------------
# Server-side pepper mixed into every stored IP hash. Set once and keep
# stable -- changing it invalidates existing rate-limit/dedup history tied to
# hashed IPs (ratings' one-vote-per-IP constraint, download-beacon windows).
# Generate the same way as the admin token above.
LUTR_IP_PEPPER=

# --- Network -----------------------------------------------------------------
PORT=8420
# Comma-separated list of origins allowed to call the public endpoints.
LUTR_CORS_ORIGINS=https://cyberhirsch.github.io
# Cloudflare Tunnel token for the lutr-tunnel compose sidecar.
TUNNEL_TOKEN=

# --- Storage -----------------------------------------------------------------
LUTR_DB_PATH=/data/db/lutr.sqlite
