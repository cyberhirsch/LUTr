# Local source libraries are used to generate the committed static prototype,
# but are intentionally not pushed to keep the GitHub repository and Pages
# artifact compact.
Images/**
!Images/README.md
reference-images/**
submissions/**
!submissions/README.md

# Raw crawl captures and any asset whose upstream file asserts rights that
# contradict its declared license. Quarantined assets must never reach the
# public repository or the Pages artifact.
submissions-raw/**
submissions-quarantine/**

# Canonical LUTs are stored gzip-compressed to fit GitHub Pages' size and
# bandwidth budget (a plain-text .cube catalog exceeds the 1 GB Pages limit).
# The plaintext .cube is a local build artifact regenerated from
# submissions/** by scripts/convert-all-to-cube.mjs and read by
# scripts/build-preview-assets.mjs; it must never be tracked or deployed --
# only the compressed .cube.gz ships.
site/assets/luts/*.cube

# Local render logs and operating-system files.
render-previews.out.log
render-previews.err.log
.DS_Store
Thumbs.db

# Secrets. The GitHub App private key and the server's runtime .env must
# never reach the repository -- they are copied to the Pi directly (see
# server/README.md) and exist here only as local deploy staging.
server/*.pem
server/.env

# Local admin panel: has the LUTR_ADMIN_TOKEN baked in, opened via file://
# on this machine only. Never deployed, never committed.
server/*.local.html
